# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used server-side only, to create doctor accounts from the staff portal
# (Settings -> API -> service_role / secret key). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Identity Services (Continue with Google button)
# Same OAuth 2.0 Client ID configured for the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SmartSMSSolutions (SMS notifications). Create an account at
# app.smartsmssolutions.com, generate the token from the dashboard's API
# settings, and get your Sender ID approved before this will send anything.
SMARTSMS_API_TOKEN=your-smartsms-api-token
SMARTSMS_SENDER_ID=your-approved-sender-id
# Only needed if the real SmartSMS send endpoint differs from the
# io/api/client/v1/sms/ path assumed in lib/sms.ts — check your SmartSMS
# dashboard's own API reference and override here if so.
# SMARTSMS_SEND_URL=https://app.smartsmssolutions.com/io/api/client/v1/sms/

# Automatic notification retry (app/api/cron/retry-notifications, run on
# a schedule by vercel.json). Vercel Cron sends this as a bearer token
# automatically once the env var is set — generate any random string.
CRON_SECRET=your-random-secret

# Nodemailer (email notifications). SMTP_FROM must be a sender you've
# actually verified with your SMTP provider (e.g. Brevo) — a placeholder
# domain like the one below will never deliver, it'll just show as "Sent"
# while silently failing at the recipient's mail server.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="CareSlot <your-verified-sender@example.com>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Self-service staff signup (register page "I'm hospital staff" toggle) checks
# the email against the "Approved staff roster" an admin maintains in
# Staff Settings, then verifies a one-time code before the account is
# created. No env var needed here — see the staff_roster table.
