# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used server-side only, to create doctor accounts from the staff portal
# (Settings -> API -> service_role / secret key). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Identity Services (Continue with Google button)
# Same OAuth 2.0 Client ID configured for the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000

# Nodemailer (email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="CareSlot <no-reply@careslot.example>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Self-service staff signup (register page "I'm hospital staff" toggle):
# only email addresses ending in this domain can request a staff/doctor
# account, and even then must verify a one-time code before the account
# is created. Set this to your hospital's real email domain.
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=unityhospital.org
